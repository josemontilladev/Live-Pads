# Dependencies & builds
node_modules/
dist/
out/

# Binarios grandes (descargar localmente si se necesitan)
ffmpeg.exe
*.exe

# Backups locales de audio re-encoded (los originales son recuperables
# desde git history). Conservamos los .gitkeep para que las carpetas
# sigan tracked.
audio_assets/originales/**
audio_assets/secuencias/**
!audio_assets/**/.gitkeep

# Logs y temporales
*.log
*.tmp
.DS_Store
Thumbs.db

# Configuracion local con credenciales / userData
config.local.json
.env
.env.*

# Editor / IDE
.vscode/
.idea/
*.swp

# Claude Code session data
.claude/
.agents/
skills-lock.json

# Stem separation: ONNX models (large binaries, fetched via scripts/fetch-models)
models/*.onnx
scripts/stem-poc/models/*.onnx
scripts/stem-poc/node_modules/
scripts/stem-poc/*.wav
scripts/stem-poc/*.mp3

# Original audio tracks dropped in defaults during dev (not shipped)
defaults/Original Tracks/
