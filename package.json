{
  "name": "livepads",
  "version": "1.0.0",
  "description": "LivePads - Pads de adoración profesionales para iglesia y presentaciones en vivo",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "dev": "electron . --dev"
  },
  "author": "LivePads",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.livepads.app",
    "productName": "LivePads",
    "win": {
      "target": "nsis",
      "icon": "src/assets/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "src/assets/logo.png",
      "uninstallerIcon": "src/assets/logo.png",
      "installerHeaderIcon": "src/assets/logo.png"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ]
  }
}
