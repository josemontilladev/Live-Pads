{
  "name": "livepads",
  "version": "1.0.318",
  "description": "LivePads — Pads de adoración profesionales para iglesia y presentaciones en vivo",
  "main": "main.js",
  "author": {
    "name": "LivePads",
    "email": "proyectos@pencilspeech.com"
  },
  "license": "MIT",
  "scripts": {
    "publish:companion": "node scripts/publish-companion.cjs",
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:ui": "node tests/ui/run.mjs",
    "fetch-models": "node scripts/fetch-models.mjs",
    "build": "node scripts/write-google-secret.mjs && electron-builder --win",
    "release": "node scripts/write-google-secret.mjs && electron-builder --win --publish always",
    "build:dir": "electron-builder --win --dir",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --mac --linux",
    "rebuild": "electron-rebuild -f",
    "test:admin": "node tests/admin/run.mjs",
    "test:e2e": "node tests/e2e/run.mjs"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "electron": "^45.3.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "kissfft-js": "^0.1.8",
    "onnxruntime-node": "^1.26.0",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "tesseract.js": "^5.1.1",
    "ws": "^8.20.1"
  },
  "build": {
    "appId": "com.livepads.app",
    "productName": "LivePads",
    "copyright": "Copyright © 2026 LivePads",
    "publish": [
      {
        "provider": "github",
        "owner": "josemontilladev",
        "repo": "Live-Pads",
        "releaseType": "release"
      }
    ],
    "releaseInfo": {
      "releaseNotesFile": "NOVEDADES.md"
    },
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "servicePack.js",
      "redundancy.js",
      "planningCenter.js",
      "multitrackImport.js",
      "whisperGuide.js",
      "lyricsAlign.js",
      "whisperWorker.js",
      "stemSeparator.js",
      "beatTracker.js",
      "chordModel.js",
      "analysisWorker.js",
      "separationWorker.js",
      "src/**/*",
      "companion/**/*",
      "!src/**/*.map",
      "!**/*.{md,markdown,log,bak,backup,asd}",
      "!**/{.DS_Store,Thumbs.db,.git,.gitignore,.idea,.vscode,.editorconfig}",
      "!**/{test,tests,__tests__,spec,__mocks__}/**",
      "!**/{LICENSE,README,CHANGELOG,HISTORY,CONTRIBUTING}*",
      "!**/node_modules/*/{example,examples,demo,docs,doc,sample,samples}/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
      "!node_modules/**/*.map",
      "!node_modules/pdfjs-dist/{legacy,web,types,image_decoders,cmaps,standard_fonts,lib}/**",
      "!node_modules/pdfjs-dist/build/{pdf.mjs,pdf.worker.mjs,pdf.sandbox.mjs,pdf.sandbox.min.mjs,pdf.d.mts}",
      "!node_modules/tesseract.js-core/{tesseract-core.js,tesseract-core.wasm,tesseract-core.wasm.js,tesseract-core-simd.js,tesseract-core-simd.wasm,tesseract-core-simd.wasm.js,tesseract-core-lstm.js,tesseract-core-lstm.wasm,tesseract-core-simd-lstm.js,tesseract-core-simd-lstm.wasm}",
      "!node_modules/tesseract.js/{src,docs,scripts,tests,benchmarks}/**"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "node_modules/kissfft-js/**"
    ],
    "extraResources": [
      {
        "from": "defaults",
        "to": "defaults",
        "filter": [
          "**/*",
          "!**/.gitkeep",
          "!Original Tracks/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "verifyUpdateCodeSignature": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "src/assets/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "public.app-category.music"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "AudioVideo;Audio"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LivePads",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false
    },
    "afterPack": "scripts/afterPack.js"
  }
}
