{
  "name": "livepads",
  "version": "1.0.0",
  "description": "LivePads — Pads de adoración profesionales para iglesia y presentaciones en vivo",
  "main": "main.js",
  "author": {
    "name": "LivePads",
    "email": "proyectos@pencilspeech.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --mac --linux",
    "rebuild": "electron-rebuild -f -w mongodb"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "mp3-cutter": "^1.0.6"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "mongodb": "^7.2.0",
    "qrcode": "^1.5.4",
    "ws": "^8.20.1"
  },
  "build": {
    "appId": "com.livepads.app",
    "productName": "LivePads",
    "copyright": "Copyright © 2026 LivePads",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "!src/**/*.map",
      "!**/*.{md,markdown,log,bak,backup,asd}",
      "!**/{.DS_Store,Thumbs.db,.git,.gitignore,.idea,.vscode,.editorconfig}",
      "!**/{test,tests,__tests__,spec,__mocks__}/**",
      "!**/{LICENSE,README,CHANGELOG,HISTORY,CONTRIBUTING}*",
      "!**/node_modules/*/{example,examples,demo,docs,doc,sample,samples}/**"
    ],
    "extraResources": [
      {
        "from": "defaults",
        "to": "defaults",
        "filter": [
          "**/*",
          "!**/.gitkeep"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.png",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "signtoolOptions": {
        "publisherName": "LivePads"
      }
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "src/assets/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "public.app-category.music"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "AudioVideo;Audio"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LivePads",
      "deleteAppDataOnUninstall": false
    }
  }
}
