{
  "name": "livepads",
  "version": "1.0.0",
  "description": "LivePads - Pads de adoración profesionales para iglesia y presentaciones en vivo",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "dev": "electron . --dev"
  },
  "author": "LivePads",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "mp3-cutter": "^1.0.6"
  },
  "build": {
    "appId": "com.livepads.app",
    "productName": "LivePads",
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "defaults/**/*",
      "!**/*.asd",
      "!**/*.wav.asd"
    ]
  },
  "dependencies": {
    "mongodb": "^7.2.0"
  }
}
